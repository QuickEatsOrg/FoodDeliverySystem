@model FoodDelivery.MVC.ViewModel.MenuItemDetailsViewModel

@{
    ViewData["Title"] = "Item Details";
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-7">
            <section class="mb-4">
                <div class="d-flex justify-content-between gap-3">
                    <div>
                        <h1 class="mb-1">@Model.ItemName</h1>
                        <div class="text-muted">@Model.CuisineCategory</div>
                    </div>
                    <div class="text-end">
                    @*
                        @if (Model.AverageRating.HasValue)
                        {
                            <span class="rating-badge">@Model.AverageRating.Value.ToString("0.0") rating</span>
                        }
                        else
                        {
                            <div class="text-muted">No ratings yet</div>
                        }
                        *@
                        <div class="price-text mt-2">@Model.ItemPrice.ToString("C")</div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.ItemDescription))
                {
                    <p class="mt-3 text-muted">@Model.ItemDescription</p>
                }

                <div class="d-flex align-items-center gap-3 mt-3">
                    @if (Model.Quantity == 0)
                    {
                        <form asp-action="UpdateQuantity" method="post">
                            <input type="hidden" name="itemId" value="@Model.ItemId" />
                            <input type="hidden" name="change" value="1" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <button type="submit" class="btn btn-primary">Add</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="UpdateQuantity" method="post">
                            <input type="hidden" name="itemId" value="@Model.ItemId" />
                            <input type="hidden" name="change" value="-1" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <button type="submit" class="btn btn-outline-secondary">-</button>
                        </form>
                        <span>@Model.Quantity</span>
                        <form asp-action="UpdateQuantity" method="post">
                            <input type="hidden" name="itemId" value="@Model.ItemId" />
                            <input type="hidden" name="change" value="1" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <button type="submit" class="btn btn-outline-secondary" @(Model.Quantity >= 10 ? "disabled" : "")>+</button>
                        </form>
                    }

                    @* TODO: Integrate with OrderController when teammate's order module is ready. *@
                    <a href="/Orders" class="btn btn-success">Order Now</a>
                </div>
            </section>

            <section>
                <h2 class="h4">More from @Model.RestaurantName</h2>
                @if (!Model.OtherMenuItems.Any())
                {
                    <p class="text-muted">No other menu items found.</p>
                }
                else
                {
                    <div class="row row-cols-1 row-cols-md-2 g-3">
                        @foreach (var item in Model.OtherMenuItems)
                        {
                            <div class="col">
                                <div class="card h-100 menu-card food-card" data-details-url="@Url.Action("Details", "MenuItems", new { id = item.ItemId })" tabindex="0" role="link" aria-label="View @item.ItemName details">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between gap-3">
                                            <div class="food-card-main">
                                                <h5 class="card-title mb-1">@item.ItemName</h5>
                                                <div class="text-muted text-truncate">@item.CuisineCategory</div>
                                            </div>
                                            <div class="food-card-side text-end">
                                                <div class="price-text">@item.ItemPrice.ToString("C")</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>
        </div>

        <div class="col-lg-5">
            <section class="border rounded p-3">
                <div class="d-flex justify-content-between gap-3">
                    <div>
                        <h2 class="h4 mb-1">@Model.RestaurantName</h2>
                        @if (!string.IsNullOrWhiteSpace(Model.RestaurantAddress))
                        {
                            <div class="text-muted">@Model.RestaurantAddress</div>
                        }
                    </div>
                    <div class="text-end">
                        @if (Model.AverageRating.HasValue)
                        {
                            <span class="rating-badge">@Model.AverageRating.Value.ToString("0.0") rating</span>
                        }
                        else
                        {
                            <div class="text-muted small">No ratings yet</div>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.RestaurantPhone))
                {
                    <div class="mt-3">@Model.RestaurantPhone</div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.RestaurantEmail))
                {
                    <div>@Model.RestaurantEmail</div>
                }
            </section>
        </div>
    </div>
}
