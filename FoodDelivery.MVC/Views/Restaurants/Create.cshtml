@model FoodDelivery.MVC.ViewModel.RestaurantCreateViewModel

@{
    ViewData["Title"] = "Add Restaurant";
}

<h1>Add Restaurant</h1>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="RestaurantName" class="form-label"></label>
                <input asp-for="RestaurantName" class="form-control" />
                <span asp-validation-for="RestaurantName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="RestaurantAddress" class="form-label"></label>
                <input asp-for="RestaurantAddress" class="form-control" />
                <span asp-validation-for="RestaurantAddress" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="RestaurantPhone" class="form-label"></label>
                <input asp-for="RestaurantPhone" class="form-control" />
                <span asp-validation-for="RestaurantPhone" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="RestaurantEmail" class="form-label"></label>
                <input asp-for="RestaurantEmail" class="form-control" />
                <span asp-validation-for="RestaurantEmail" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Register</button>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
