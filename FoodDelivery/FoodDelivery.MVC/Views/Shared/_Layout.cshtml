<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FoodDelivery Driver</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Driver" asp-action="Dashboard">
                    FoodDelivery Driver
                </a>

                <div class="navbar-nav ms-auto">
                    <a class="nav-link text-light" asp-controller="Driver" asp-action="Dashboard">Dashboard</a>
                    <a class="nav-link text-light" asp-controller="Driver" asp-action="MyDeliveries">My Deliveries</a>
                    <a class="nav-link text-light" asp-controller="Auth" asp-action="Logout">Logout</a>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container pb-3">
        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>