@model FoodDelivery.MVC.ViewModel.DriverRegisterViewModel

@{
    ViewData["Title"] = "Driver Register";
}

<div class="auth-wrap">
    <div>
        <p class="eyebrow">Delivery Driver</p>
        <h1>Create driver account</h1>
        <p class="text-muted">Register to access assigned deliveries and delivery status pages.</p>
    </div>
    <form asp-action="Register" method="post" class="auth-card">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3"><label asp-for="DriverName" class="form-label"></label><input asp-for="DriverName" class="form-control" /><span asp-validation-for="DriverName" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="DriverEmail" class="form-label"></label><input asp-for="DriverEmail" class="form-control" /><span asp-validation-for="DriverEmail" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="DriverPhone" class="form-label"></label><input asp-for="DriverPhone" class="form-control" /><span asp-validation-for="DriverPhone" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="DriverVehicle" class="form-label"></label><input asp-for="DriverVehicle" class="form-control" /><span asp-validation-for="DriverVehicle" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" /><span asp-validation-for="Password" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
        <button class="btn btn-primary w-100" type="submit">Register</button>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
